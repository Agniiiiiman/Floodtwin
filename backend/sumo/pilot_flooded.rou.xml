    <!-- Evacuation detour route avoiding the flooded street_segment_02 low point -->
    <route id="detour_route" edges="street_segment_01 bypass_edge_01 bypass_edge_02 street_segment_04"/>
    
    <!-- Flooded scenario traffic: all 60 vehicles redirected along bypass corridor with speed restrictions due to water accumulation -->
