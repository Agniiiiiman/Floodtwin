{
  "name": "floodtwin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"bgRed.bold,bgBlue.bold\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
